# ─── Authentication (mandatory) ─────────────────────────────────────────────
# Every route except GET /health requires one of:
#   Authorization: Bearer <API_TOKEN>
#   X-API-Token: <API_TOKEN>
API_TOKEN=change-me-to-a-secure-token

# Optional stronger token for administrative mutations:
#   POST /v1/models
#   POST /v1/models/discover
#   POST /api/sync-cookies
# Empty = fall back to API_TOKEN.
# NOTE: the Chrome extension stores one sync token. Leave ADMIN_TOKEN and
# WS_TOKEN empty (recommended) or set them to the same value as API_TOKEN.
ADMIN_TOKEN=

# WebSocket bridge token. Empty = fall back to API_TOKEN.
WS_TOKEN=

# Host UID/GID used by docker-compose for bind-mounted cookies/data/output.
# Set these to `id -u` and `id -g` so the local Go toolchain and the container
# can share the same runtime files. The image itself defaults to non-root 10001.
HOST_UID=1000
HOST_GID=1000

# ─── Network binding ────────────────────────────────────────────────────────
# Loopback by default. Use 0.0.0.0 only inside a container whose published
# ports are themselves bound to 127.0.0.1.
API_HOST=127.0.0.1
PORT=8100
WS_HOST=127.0.0.1
WS_PORT=9226

# ─── CORS / rate limiting ───────────────────────────────────────────────────
# Comma-separated exact origins. When empty, loopback origins and Chrome
# extension origins are allowed.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8100,http://localhost:8100
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_SECONDS=60

# Set to true to make GET / and GET /help public. Default: protected.
PUBLIC_HELP=false

# ─── Chiffrement des cookies au repos (A-24) ────────────────────────────────
# Clé AES-256-GCM des fichiers cookies/account_*.json et des caches de session.
# 64 caractères hexadécimaux = clé directe ; toute autre valeur est étirée avec
# PBKDF2-HMAC-SHA256 (100 000 itérations). Générer avec :
#   openssl rand -hex 32
# Vide = stockage en clair (avertissement au démarrage).
COOKIE_ENCRYPTION_KEY=
# true = refuser de démarrer si COOKIE_ENCRYPTION_KEY est vide.
REQUIRE_COOKIE_ENCRYPTION=false

# ─── Métriques Prometheus (A-27) ────────────────────────────────────────────
# GET /metrics exige API_TOKEN (ou ADMIN_TOKEN). true = scrape sans jeton
# depuis le loopback uniquement (Prometheus local).
PUBLIC_METRICS=false

# ─── Routage Task Mode et mémoire des sessions (v3.5.7 P1) ──────────────────
# Les requêtes qui déclarent des outils sont routées par défaut du mode Task
# [40] vers l'alias Chat [0] de la même famille (hydrogen-task -> hydrogen,
# neon-task -> neon) afin de préserver la boucle d'outils externe.
# true = conserver Task Mode [40] pour ces requêtes. Un client peut aussi
# utiliser l'en-tête X-Allow-Task-Mode-For-Tools: true.
ALLOW_TASK_MODE_FOR_TOOLS=false
# Budget mémoire global des transcripts de session (lastFlat), en mégaoctets.
# Au-delà, les sessions les moins récemment utilisées sont évincées et
# rejoueront leur transcript complet au tour suivant.
SESSION_MEMORY_BUDGET_MB=64

# ─── GDPR / rétention ───────────────────────────────────────────────────────
# Nombre de jours de conservation des messages, métadonnées de médias et
# journaux de requêtes. 0 désactive la purge automatique (déconseillé).
RETENTION_DAYS=30

# ─── Serveur MCP (stdio) ────────────────────────────────────────────────────
# Racine autorisée pour les fichiers passés aux outils MCP. Les chemins
# absolus, la traversée et les liens symboliques qui sortent de cette racine
# sont rejetés.
MCP_MEDIA_ROOT=./output
# Jeton utilisé par le serveur MCP pour appeler l'API locale.
# Vide = repli sur API_TOKEN.
MCP_TOKEN=

# ─── Base de données ────────────────────────────────────────────────────────
# Chemin SQLite personnalisé (défaut : data/gemini.db).
# GEMINI_DB_PATH=
